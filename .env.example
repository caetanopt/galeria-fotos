# URL pública da aplicação. Em produção, o domínio real (https://...).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------
# Project Settings → API no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SEGREDO. Apenas servidor — nunca expor ao browser (CLAUDE.md §24.8).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (ligação ao Drive) --------------------------------
# Credenciais "Web application" da Google Cloud Console. Diferentes das
# usadas no fornecedor Google do Supabase Auth (ver README).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-drive/callback

# --- Segredos da aplicação ------------------------------------------
# Chave de encriptação dos refresh tokens (AES-256-GCM), >= 32 bytes.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Pepper dos hashes de tokens de partilha, >= 16 caracteres.
#   openssl rand -base64 24
APP_TOKEN_PEPPER=

# --- Limites de upload e processamento ------------------------------
# Tamanho máximo por ficheiro recebido pelo servidor, em bytes.
# 4 MB é o teto do corpo de um pedido nas funções serverless da Vercel;
# o cliente otimiza as imagens antes de enviar. Num alojamento sem esse
# limite (Cloud Run, self-hosted) pode subir para 26214400 (25 MB).
MAX_UPLOAD_BYTES=4000000
MAX_FILES_PER_UPLOAD=50
MAX_PHOTOS_PER_ALBUM=5000
PREVIEW_MAX_EDGE=1600
THUMBNAIL_MAX_EDGE=480

# --- Administração ---------------------------------------------------
# Emails sempre tratados como administradores (bootstrap do primeiro
# admin), separados por vírgula.
ADMIN_EMAILS=

# --- Opcional --------------------------------------------------------
# Rate limiting. Sem estas duas, o rate limit fica desligado.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
# Autoriza /api/cron/* (>= 16 caracteres). Sem esta variável, a rota de
# sincronização com o Drive fecha por omissão. Na Vercel, o nome tem de
# ser exatamente CRON_SECRET.
CRON_SECRET=
